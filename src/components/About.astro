---
import { data } from '@/config/data';
---

<section id="about" class="py-20 bg-base-800/50">
    <div class="container px-4 mx-auto sm:px-6 lg:px-8">
        <div class="flex flex-col items-center gap-12 md:flex-row">
            <!-- Image -->
            <div class="flex justify-center w-full md:w-2/5">
                <div class="relative">
                    <div class="w-64 h-64 p-1 overflow-hidden border-4 border-accent-500 rounded-full sm:w-80 sm:h-80">
                        <div class="w-full h-full overflow-hidden rounded-full">
                            <img src={data.profilePicture} alt={`${data.name} profile photo`} class="object-cover w-full h-full" loading="lazy" />
                        </div>
                    </div>
                    <div class="absolute w-24 h-24 rounded-full -top-4 -right-4 bg-blue-500/20 blur-xl"></div>
                    <div class="absolute w-24 h-24 rounded-full -bottom-4 -left-4 bg-accent-500/20 blur-xl"></div>
                </div>
            </div>

            <!-- Content -->
            <div class="w-full md:w-3/5">
                <h2 class="mb-2 text-3xl font-bold">About Me</h2>
                <div class="w-20 h-1 mb-6 bg-accent-500"></div>

                <p class="mb-4 text-base-300">
                    I'm a full-stack developer who started building web apps with React, Angular, and NestJS and eventually found my way into blockchain. These days I work mostly with Stellar and Ethereum, building decentralized applications and smart contracts.
                </p>

                <p class="mb-8 text-base-300">
                    I also enjoy mentoring. I've worked with the Stellar Development Foundation and Aptos Foundation helping teams bring their ideas to life. Whether it's a traditional web app or a Web3 project, I care about writing clean code that actually solves the problem.
                </p>

                <a
                    href="#contact"
                    class="inline-block px-6 py-3 font-medium text-white transition-colors duration-300 bg-accent-600 rounded-lg hover:bg-accent-700"
                >
                    Let's Work Together
                </a>
            </div>
        </div>
    </div>
</section>
