---
import { data } from '@/config/data';
import UiIcon from '@/components/icons/UiIcon.astro';
import SocialLinks from '@/components/icons/social/SocialLinks.astro';
---

<div class="flex flex-col h-full p-6 border bg-slate-800/80 backdrop-blur-sm rounded-xl border-slate-700">
    <h3 class="mb-6 text-xl font-semibold">Contact Information</h3>

    <div class="space-y-4">
        <div class="flex items-start">
            <div class="p-2 mr-4 rounded-md bg-indigo-500/10">
                <UiIcon name="mail" size={20} class="text-indigo-400" />
            </div>
            <div>
                <p class="text-sm text-slate-400">Email</p>
                <a
                    href={`mailto:${data.email}`}
                    class="transition-colors text-slate-200 hover:text-indigo-400"
                >
                    {data.email}
                </a>
            </div>
        </div>

        <div class="flex items-start">
            <div class="p-2 mr-4 rounded-md bg-indigo-500/10">
                <UiIcon name="marker-pin" size={20} class="text-indigo-400" />
            </div>
            <div>
                <p class="text-sm text-slate-400">Location</p>
                <p class="text-slate-200">{data.address}</p>
            </div>
        </div>
    </div>

    <div class="pt-6 mt-8 border-t border-slate-700">
        <h4 class="mb-4 text-lg font-medium">Connect with me</h4>
        <SocialLinks />
    </div>

    <div class="flex items-center gap-2 pt-6 mt-auto">
        <span class="relative flex w-3 h-3">
            <span class="absolute inline-flex w-full h-full rounded-full opacity-75 animate-ping bg-green-400"></span>
            <span class="relative inline-flex w-3 h-3 rounded-full bg-green-500"></span>
        </span>
        <span class="text-sm text-slate-300">Available for new projects</span>
    </div>
</div>
