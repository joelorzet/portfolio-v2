---
import ContactInfo from './ContactInfo.astro';
import ContactForm from './ContactForm.astro';
---

<section id="contact" class="py-20 bg-gradient-to-b from-base-900 to-base-800">
    <div class="container px-4 mx-auto sm:px-6 lg:px-8">
        <div class="mb-16 text-center">
            <h2 class="mb-2 text-3xl font-bold">Get In Touch</h2>
            <div class="w-20 h-1 mx-auto mb-6 bg-accent-500"></div>
            <p class="max-w-3xl mx-auto text-base-300">
                Have a project in mind or want to explore collaboration opportunities? Feel free to reach out,
                and I'll get back to you as soon as possible.
            </p>
        </div>

        <div class="grid grid-cols-1 gap-8 lg:grid-cols-5">
            <div class="lg:col-span-2">
                <ContactInfo />
            </div>
            <div class="lg:col-span-3">
                <ContactForm />
            </div>
        </div>
    </div>
</section>
