---
import { data } from '@/config/data';
import UiIcon from '@/components/icons/UiIcon.astro';
---

<section id="experience" class="py-20 bg-base-800/50">
    <div class="container px-4 mx-auto sm:px-6 lg:px-8">
        <div class="mb-16 text-center">
            <h2 class="mb-2 text-3xl font-bold">Professional Experience</h2>
            <div class="w-20 h-1 mx-auto mb-6 bg-accent-500"></div>
            <p class="max-w-3xl mx-auto text-base-300">
                My professional journey through various roles and technologies.
            </p>
        </div>

        <!-- Desktop timeline -->
        <div class="relative hidden md:block">
            <div class="absolute left-1/2 w-1 h-full -translate-x-1/2 bg-accent-500/30"></div>

            <div class="space-y-12">
                {data.experiences.map((experience, index) => {
                    const isEven = index % 2 === 0;
                    return (
                        <div class="relative flex items-center">
                            <div class="absolute left-1/2 z-10 w-4 h-4 -translate-x-1/2 bg-accent-500 rounded-full"></div>

                            {isEven ? (
                                <>
                                    <div class="w-1/2 pr-12">
                                        <div class="bg-base-800 p-6 rounded-lg border-l-4 border-accent-500 shadow-md transition-transform duration-300 hover:-translate-y-1">
                                            <div class="flex items-start mb-3">
                                                <div class="p-2 mr-4 rounded-md bg-accent-500/10">
                                                    <UiIcon name="briefcase" size={20} class="text-accent-400" />
                                                </div>
                                                <div>
                                                    <h3 class="text-xl font-bold">{experience.title}</h3>
                                                    <p class="text-accent-400">{experience.company}</p>
                                                </div>
                                            </div>
                                            <p class="mb-4 text-base-300">{experience.description}</p>
                                            <div class="flex flex-wrap gap-2">
                                                {experience.technologies.map((tech) => (
                                                    <span class="px-2 py-1 text-xs rounded bg-base-700 text-base-300">{tech}</span>
                                                ))}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="w-1/2 pl-12">
                                        <div class="flex items-center text-accent-400">
                                            <UiIcon name="calendar" size={16} class="mr-2" />
                                            <span class="text-sm">{experience.period}</span>
                                        </div>
                                    </div>
                                </>
                            ) : (
                                <>
                                    <div class="w-1/2 pr-12 flex justify-end">
                                        <div class="flex items-center text-accent-400">
                                            <UiIcon name="calendar" size={16} class="mr-2" />
                                            <span class="text-sm">{experience.period}</span>
                                        </div>
                                    </div>
                                    <div class="w-1/2 pl-12">
                                        <div class="bg-base-800 p-6 rounded-lg border-l-4 border-accent-500 shadow-md transition-transform duration-300 hover:-translate-y-1">
                                            <div class="flex items-start mb-3">
                                                <div class="p-2 mr-4 rounded-md bg-accent-500/10">
                                                    <UiIcon name="briefcase" size={20} class="text-accent-400" />
                                                </div>
                                                <div>
                                                    <h3 class="text-xl font-bold">{experience.title}</h3>
                                                    <p class="text-accent-400">{experience.company}</p>
                                                </div>
                                            </div>
                                            <p class="mb-4 text-base-300">{experience.description}</p>
                                            <div class="flex flex-wrap gap-2">
                                                {experience.technologies.map((tech) => (
                                                    <span class="px-2 py-1 text-xs rounded bg-base-700 text-base-300">{tech}</span>
                                                ))}
                                            </div>
                                        </div>
                                    </div>
                                </>
                            )}
                        </div>
                    );
                })}
            </div>
        </div>

        <!-- Mobile timeline -->
        <div class="md:hidden">
            <div class="space-y-4">
                {data.experiences.map((experience) => (
                    <div class="flex gap-4">
                        <div class="flex flex-col items-center flex-shrink-0">
                            <div class="w-1 flex-1 bg-accent-500/30"></div>
                            <div class="w-3 h-3 rounded-full bg-accent-500 flex-shrink-0 my-1"></div>
                            <div class="w-1 flex-1 bg-accent-500/30"></div>
                        </div>
                        <div class="flex-1 py-1">
                            <div class="bg-base-800 p-5 rounded-lg border-l-4 border-accent-500 shadow-md">
                                <div class="flex items-center text-accent-400 mb-3">
                                    <UiIcon name="calendar" size={14} class="mr-1.5" />
                                    <span class="text-sm">{experience.period}</span>
                                </div>
                                <div class="flex items-start mb-3">
                                    <div class="p-2 mr-3 rounded-md bg-accent-500/10">
                                        <UiIcon name="briefcase" size={18} class="text-accent-400" />
                                    </div>
                                    <div>
                                        <h3 class="text-lg font-bold">{experience.title}</h3>
                                        <p class="text-sm text-accent-400">{experience.company}</p>
                                    </div>
                                </div>
                                <p class="mb-3 text-sm text-base-300">{experience.description}</p>
                                <div class="flex flex-wrap gap-1.5">
                                    {experience.technologies.map((tech) => (
                                        <span class="px-2 py-0.5 text-xs rounded bg-base-700 text-base-300">{tech}</span>
                                    ))}
                                </div>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </div>
</section>
