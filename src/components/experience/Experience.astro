---
import { data } from '@/config/data';
import UiIcon from '@/components/icons/UiIcon.astro';
---

<section id="experience" class="py-20 bg-slate-800/50">
    <div class="container px-4 mx-auto sm:px-6 lg:px-8">
        <div class="mb-16 text-center">
            <h2 class="mb-2 text-3xl font-bold">Professional Experience</h2>
            <div class="w-20 h-1 mx-auto mb-6 bg-indigo-500"></div>
            <p class="max-w-3xl mx-auto text-slate-300">
                My professional journey through various roles and technologies.
            </p>
        </div>

        <div class="relative">
            <div class="absolute left-0 w-1 h-full transform md:left-1/2 md:-translate-x-1/2 bg-indigo-500/30"></div>

            <div class="space-y-12">
                {data.experiences.map((experience, index) => {
                    const isEven = index % 2 === 0;
                    return (
                        <div class="relative">
                            <div class="absolute left-0 z-10 w-4 h-4 transform -translate-x-1/2 bg-indigo-500 rounded-full md:left-1/2 -translate-y-1/3"></div>

                            <div class={`flex flex-col ${isEven ? 'md:flex-row-reverse' : 'md:flex-row'}`}>
                                <div class="flex items-start justify-start pb-8 md:w-1/2 md:pb-0 md:justify-end">
                                    <div class={`px-4 ${isEven ? 'md:pl-16 md:mr-auto' : 'md:pl-0 md:pr-16'}`}>
                                        <div class="flex items-center mb-1 text-indigo-400">
                                            <UiIcon name="calendar" size={16} class="mr-2" />
                                            <span class="text-sm">{experience.period}</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="pl-8 md:w-1/2 md:pl-16">
                                    <div class={`bg-slate-800 p-6 rounded-lg border-l-4 border-indigo-500 shadow-md transform transition-transform duration-300 hover:-translate-y-1 ${isEven ? 'md:mr-16' : ''}`}>
                                        <div class="flex items-start mb-3">
                                            <div class="p-2 mr-4 rounded-md bg-indigo-500/10">
                                                <UiIcon name="briefcase" size={20} class="text-indigo-400" />
                                            </div>
                                            <div>
                                                <h3 class="text-xl font-bold">{experience.title}</h3>
                                                <p class="text-indigo-400">{experience.company}</p>
                                            </div>
                                        </div>

                                        <p class="mb-4 text-slate-300">{experience.description}</p>

                                        <div class="flex flex-wrap gap-2">
                                            {experience.technologies.map((tech) => (
                                                <span class="px-2 py-1 text-xs rounded bg-slate-700 text-slate-300">
                                                    {tech}
                                                </span>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    );
                })}
            </div>
        </div>
    </div>
</section>
