---
import UiIcon from '@/components/icons/UiIcon.astro';
---

<section class="relative flex flex-col items-center justify-center min-h-[60vh] pt-24 pb-16 text-center overflow-hidden">
    <div class="absolute inset-0 z-0">
        <div class="absolute w-72 h-72 rounded-full top-20 left-10 bg-indigo-600/10 blur-3xl"></div>
        <div class="absolute w-72 h-72 rounded-full bottom-10 right-10 bg-blue-600/10 blur-3xl"></div>
    </div>

    <div class="container z-10 px-4 mx-auto sm:px-6 lg:px-8">
        <div class="inline-flex items-center justify-center p-2 mb-6 rounded-full bg-slate-800/50 backdrop-blur-sm">
            <span class="px-4 text-sm font-medium text-indigo-400">Open to new projects</span>
        </div>

        <h1 class="mb-6 text-4xl font-bold leading-tight sm:text-5xl md:text-6xl">
            Let's Build Something<br />
            <span class="text-indigo-400">Together</span>
        </h1>

        <p class="max-w-2xl mx-auto mb-10 text-lg text-slate-300 sm:text-xl">
            I partner with businesses and founders to deliver high-quality, scalable software solutions
            - from modern web apps to blockchain-powered platforms.
        </p>

        <button
            data-open-dialog
            data-service="Project"
            data-message="Hi Joel, I have a project idea I'd like to discuss with you. I'm looking for a developer to help bring it to life."
            class="inline-flex items-center gap-2 px-8 py-3 font-medium text-white transition-colors duration-300 bg-indigo-600 rounded-full cursor-pointer hover:bg-indigo-700"
        >
            <UiIcon name="rocket" size={20} />
            Get in Touch
        </button>
    </div>
</section>
