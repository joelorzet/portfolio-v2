---
import UiIcon from '@/components/icons/UiIcon.astro';
---

<dialog id="contact-dialog" class="backdrop:bg-black/60 backdrop:backdrop-blur-sm bg-transparent p-0 m-auto max-w-lg w-full open:animate-fade-in">
    <div class="p-6 border bg-slate-800 rounded-xl border-slate-700 shadow-2xl">
        <div class="flex items-center justify-between mb-6">
            <h3 class="text-xl font-semibold text-white">Get in Touch</h3>
            <button id="dialog-close" class="p-1 transition-colors rounded-lg text-slate-400 hover:text-white hover:bg-slate-700">
                <UiIcon name="x-close" size={20} />
            </button>
        </div>

        <form id="dialog-contact-form" class="space-y-4">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div>
                    <label for="dialog-name" class="block mb-1 text-sm font-medium text-slate-300">Your Name</label>
                    <input type="text" id="dialog-name" name="name" required class="w-full px-4 py-2 text-white transition-colors border rounded-lg border-slate-600 bg-slate-700/50 focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-transparent" placeholder="Your name" />
                </div>
                <div>
                    <label for="dialog-email" class="block mb-1 text-sm font-medium text-slate-300">Email Address</label>
                    <input type="email" id="dialog-email" name="email" required class="w-full px-4 py-2 text-white transition-colors border rounded-lg border-slate-600 bg-slate-700/50 focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-transparent" placeholder="you@company.com" />
                </div>
            </div>

            <div>
                <label for="dialog-subject" class="block mb-1 text-sm font-medium text-slate-300">Subject</label>
                <input type="text" id="dialog-subject" name="subject" required class="w-full px-4 py-2 text-white transition-colors border rounded-lg border-slate-600 bg-slate-700/50 focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-transparent" placeholder="Project Inquiry" />
            </div>

            <div>
                <label for="dialog-message" class="block mb-1 text-sm font-medium text-slate-300">Your Message</label>
                <textarea id="dialog-message" name="message" required rows="4" class="w-full px-4 py-2 text-white transition-colors border rounded-lg border-slate-600 bg-slate-700/50 focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-transparent" placeholder="Hello, I'd like to discuss a project..."></textarea>
            </div>

            <div id="dialog-submit-message" class="hidden p-3 rounded-lg"></div>

            <button type="submit" id="dialog-submit-btn" class="inline-flex items-center justify-center w-full gap-2 px-6 py-3 font-medium text-white transition-all duration-300 bg-accent-600 rounded-lg hover:bg-accent-700">
                <span id="dialog-submit-default" class="inline-flex items-center gap-2"><UiIcon name="send" size={20} /> Send Message</span>
                <span id="dialog-submit-loading" class="hidden inline-flex items-center gap-2"><UiIcon name="loading" size={20} class="animate-spin" /> Sending...</span>
            </button>
        </form>
    </div>
</dialog>

<style>
    @keyframes fade-in {
        from { opacity: 0; transform: scale(0.95); }
        to { opacity: 1; transform: scale(1); }
    }
    dialog[open] {
        animation: fade-in 0.2s ease-out;
    }
</style>

<script>
    const dialog = document.getElementById('contact-dialog') as HTMLDialogElement;
    const closeBtn = document.getElementById('dialog-close')!;
    const form = document.getElementById('dialog-contact-form') as HTMLFormElement;
    const submitBtn = document.getElementById('dialog-submit-btn') as HTMLButtonElement;
    const submitDefault = document.getElementById('dialog-submit-default')!;
    const submitLoading = document.getElementById('dialog-submit-loading')!;
    const submitMessage = document.getElementById('dialog-submit-message')!;
    const subjectInput = document.getElementById('dialog-subject') as HTMLInputElement;

    const messageInput = document.getElementById('dialog-message') as HTMLTextAreaElement;

    // Open dialog from service buttons
    document.querySelectorAll<HTMLButtonElement>('[data-open-dialog]').forEach(btn => {
        btn.addEventListener('click', () => {
            const service = btn.dataset.service || '';
            const message = btn.dataset.message || '';
            subjectInput.value = `${service} Inquiry`;
            messageInput.value = message;
            dialog.showModal();
        });
    });

    closeBtn.addEventListener('click', () => dialog.close());

    // Close on backdrop click
    dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
    });

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        submitBtn.disabled = true;
        submitDefault.classList.add('hidden');
        submitLoading.classList.remove('hidden');
        submitBtn.classList.add('bg-slate-600', 'cursor-not-allowed');
        submitBtn.classList.remove('bg-accent-600', 'hover:bg-accent-700');

        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        try {
            const apiUrl = import.meta.env?.PUBLIC_API_URL;
            if (apiUrl) {
                await fetch(`${apiUrl}/contact`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data),
                });
            }
        } catch (error) {
            console.error(error);
        }

        setTimeout(() => {
            submitBtn.disabled = false;
            submitDefault.classList.remove('hidden');
            submitLoading.classList.add('hidden');
            submitBtn.classList.remove('bg-slate-600', 'cursor-not-allowed');
            submitBtn.classList.add('bg-accent-600', 'hover:bg-accent-700');

            submitMessage.classList.remove('hidden');
            submitMessage.classList.add('bg-green-500/20', 'text-green-400');
            submitMessage.textContent = 'Your message has been sent! I will get back to you soon.';

            form.reset();

            setTimeout(() => {
                submitMessage.classList.add('hidden');
                dialog.close();
            }, 3000);
        }, 1500);
    });
</script>
