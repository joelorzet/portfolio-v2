---
interface Props {
    size?: number;
    showText?: boolean;
}

const { size = 32, showText = true } = Astro.props;
---

<div class="flex items-center">
    <img
        src="/profile.webp"
        alt="Joel Orzet"
        width={size}
        height={size}
        class="rounded-lg object-cover ring-2 ring-accent-500/50"
        loading="eager"
    />
    {showText && <span class="ml-2 text-xl font-bold tracking-tight">Joel <span class="text-accent-500">Orzet</span></span>}
</div>
