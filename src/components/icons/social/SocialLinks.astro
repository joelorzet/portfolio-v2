---
import { data } from '@/config/data';
import GithubIcon from './GithubIcon.astro';
import LinkedinIcon from './LinkedinIcon.astro';
import TwitterIcon from './TwitterIcon.astro';

interface Props {
    class?: string;
    iconSize?: number;
}

const { class: className = '', iconSize = 20 } = Astro.props;
---

<div class:list={['flex space-x-4', className]}>
    <a href={data.social.github} target="_blank" rel="noopener noreferrer" class="p-2 transition-colors rounded-full bg-base-800 text-base-400 hover:text-base-100 hover:bg-accent-600" aria-label="GitHub"><GithubIcon size={iconSize} /></a>
    <a href={data.social.linkedin} target="_blank" rel="noopener noreferrer" class="p-2 transition-colors rounded-full bg-base-800 text-base-400 hover:text-base-100 hover:bg-accent-600" aria-label="LinkedIn"><LinkedinIcon size={iconSize} /></a>
    <a href={data.social.twitter} target="_blank" rel="noopener noreferrer" class="p-2 transition-colors rounded-full bg-base-800 text-base-400 hover:text-base-100 hover:bg-accent-600" aria-label="Twitter"><TwitterIcon size={iconSize} /></a>
</div>
