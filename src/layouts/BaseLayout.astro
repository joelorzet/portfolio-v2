---
import type { SEOProps } from '@/config/seo';
import { defaultSEO } from '@/config/seo';
import { theme, allPalettes } from '@/config/theme';
import '@/index.css';

interface Props {
    seo?: Partial<SEOProps>;
}

const { seo = {} } = Astro.props;
const {
    title = defaultSEO.title,
    description = defaultSEO.description,
    canonicalUrl = Astro.url.href,
    ogImage = defaultSEO.ogImage,
    ogType = defaultSEO.ogType,
    twitterCard = defaultSEO.twitterCard,
    jsonLd,
} = { ...defaultSEO, ...seo };

const ogImageUrl = ogImage?.startsWith('http') ? ogImage : new URL(ogImage || '/og-image.png', Astro.site).href;
---

<!doctype html>
<html lang="en" style={`--base-100:${theme.base['100']};--base-200:${theme.base['200']};--base-300:${theme.base['300']};--base-400:${theme.base['400']};--base-500:${theme.base['500']};--base-600:${theme.base['600']};--base-700:${theme.base['700']};--base-800:${theme.base['800']};--base-900:${theme.base['900']};--accent-400:${theme.accent['400']};--accent-500:${theme.accent['500']};--accent-600:${theme.accent['600']};--accent-700:${theme.accent['700']};--accent-hex:${theme.accentHex}`}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="canonical" href={canonicalUrl} />

        <title>{title}</title>
        <meta name="description" content={description} />

        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:type" content={ogType} />

        <meta name="twitter:card" content={twitterCard} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageUrl} />

        {jsonLd && (
            <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
        )}

        <script is:inline set:html={`(function(){var p=${JSON.stringify(allPalettes)};var t=localStorage.getItem('theme');if(t&&p[t]){var r=[];var b=p[t].base;for(var k in b)r.push('--base-'+k+':'+b[k]);var a=p[t].accent;for(var k in a)r.push('--accent-'+k+':'+a[k]);r.push('--accent-hex:'+p[t].accentHex);document.documentElement.setAttribute('style',r.join(';'))}})()`} />
    </head>
    <body class="min-h-screen bg-base-900 text-base-100 antialiased">
        <slot />
    </body>
</html>
